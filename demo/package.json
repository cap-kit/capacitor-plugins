{
  "name": "capkit-plugin-demo",
  "version": "1.0.0",
  "author": "CapKit Team",
  "homepage": "https://github.com/cap-kit/capacitor-plugins",
  "scripts": {
    "ng": "ng",
    "start": "pnpm run version && ng serve",
    "build": "pnpm run version && ng build --configuration=production",
    "version": "tsx scripts/set-version.ts",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:ios": "pnpm run build && cap sync ios && cap open ios",
    "build:android": "pnpm run build && cap sync android && cap open android",
    "ionic:add": "ionic capacitor add",
    "ionic:sync": "ionic capacitor sync",
    "ionic:open": "ionic capacitor open",
    "sanitize:team:id": "tsx scripts/sanitize-team-id.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@ionic/angular": "^9.0.10",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.6",
    "@analogjs/vitest-angular": "2.9.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/language-service": "^22.2.5",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "7.2.1",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0"
  }
}
